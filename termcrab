#!/usr/bin/env bash
# Run TermCrab straight from a checkout — no global install needed.
#
#   ./termcrab --version
#   ./termcrab onboard
#   ./termcrab gateway
#
# `npm install` alone does not produce a `termcrab` command: it fetches the
# three dev packages, and `dist/` (which holds the real CLI) only appears after
# `npm run build`. This launcher closes that gap — it compiles once on first
# run, says so out loud, and then gets out of the way. For a bare `termcrab`
# anywhere, run `npm link` once (that installs a symlink into your npm prefix).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENTRY="$ROOT/dist/src/bin/termcrab.js"

# Build when there is nothing built yet, and rebuild when the sources are newer
# than the build (the "git pull, then run" path). 37.3: the compile is
# incremental (tsconfig writes dist/.tsbuildinfo), so a rebuild after a pull is
# ~1.5 s here versus ~5 s from scratch, and the phone pays the same ratio.
NEEDS_BUILD=0
if [ ! -f "$ENTRY" ]; then
  NEEDS_BUILD=1
  echo "termcrab: no build found — compiling now (1-3 minutes on a phone, silent while tsc runs)" >&2
elif [ -n "$(find "$ROOT/src" "$ROOT/tsconfig.json" -newer "$ENTRY" -print -quit 2>/dev/null)" ]; then
  NEEDS_BUILD=2
  echo "termcrab: sources are newer than the build — recompiling (incremental)" >&2
fi

if [ "$NEEDS_BUILD" != 0 ]; then
  if [ ! -d "$ROOT/node_modules" ]; then
    echo "termcrab: installing dev packages first (3 small packages, no runtime deps)" >&2
    (cd "$ROOT" && npm install --no-fund --no-audit) >&2
  fi
  STARTED=$(date +%s%3N 2>/dev/null || echo 0)
  (cd "$ROOT" && npm run build) >&2
  ENDED=$(date +%s%3N 2>/dev/null || echo 0)
  if [ "$STARTED" != 0 ] && [ "$ENDED" != 0 ]; then
    echo "termcrab: built in $((ENDED - STARTED)) ms" >&2
  fi
fi

exec node "$ENTRY" "$@"
