{
  "name": "termcrab",
  "version": "0.72.0",
  "description": "TermCrab - the always-on AI agent that lives in your Termux. Gateway, channels, skills, memory. Zero native dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "TermCrab contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onelitonbd/claw.git"
  },
  "homepage": "https://github.com/onelitonbd/claw#readme",
  "keywords": [
    "ai-agent",
    "termux",
    "android",
    "telegram",
    "llm",
    "gateway",
    "self-hosted",
    "assistant"
  ],
  "bin": {
    "termcrab": "dist/src/bin/termcrab.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "files": [
    "dist/src",
    "skills",
    "ui",
    "docs",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:test": "tsc -p tsconfig.test.json && node scripts/copy-assets.mjs",
    "test": "npm run build:test && node --test --test-timeout=60000 dist/test/*.test.js",
    "start": "node dist/src/bin/termcrab.js",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs",
    "ci:install": "node scripts/install-ci.mjs",
    "test:coverage": "node scripts/coverage.mjs --run",
    "test:cli": "node scripts/cli-coverage.mjs --run",
    "check:measure": "node scripts/coverage.mjs --check && node scripts/cli-coverage.mjs --check",
    "bench:budget": "node scripts/bench.mjs --quick --budget",
    "test:time": "node scripts/suite-time.mjs --run",
    "smoke:telegram": "node scripts/smoke-telegram.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  }
}
